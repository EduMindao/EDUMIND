{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and student study profile information for EduMind",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Student full name", "maxLength": 100, "minLength": 2 },
        "email": { "type": "string", "description": "User email address", "maxLength": 150 },
        "educationLevel": { "type": "string", "description": "Academic level", "enum": ["Primaria", "Médio", "Superior"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["uid", "name", "email", "educationLevel"]
    },
    "Disciplina": {
      "title": "Disciplina",
      "description": "Subject created by student with list of study themes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique disciplina ID" },
        "userId": { "type": "string", "description": "Student owner UID" },
        "name": { "type": "string", "description": "Subject name", "maxLength": 80 },
        "color": { "type": "string", "description": "Badge accent color" },
        "temas": { "type": "array", "description": "List of study themes/chapters" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "name"]
    },
    "Resumo": {
      "title": "Resumo",
      "description": "Class study summary generated by Prof. Pacavira AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique summary ID" },
        "userId": { "type": "string", "description": "Student owner UID" },
        "disciplina": { "type": "string", "description": "Subject name", "maxLength": 80 },
        "tema": { "type": "string", "description": "Theme / topic name", "maxLength": 150 },
        "academicLevel": { "type": "string", "description": "Level for the lesson" },
        "content": { "type": "string", "description": "Full study summary text/markdown" },
        "keyTakeaways": { "type": "array", "description": "Bulleted key concepts" },
        "sessionDurationMinutes": { "type": "number", "description": "Pomodoro study minutes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "disciplina", "tema", "content"]
    },
    "Tarefa": {
      "title": "Tarefa",
      "description": "Interactive study exercises and activities generated from lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique task ID" },
        "userId": { "type": "string", "description": "Student owner UID" },
        "disciplina": { "type": "string", "description": "Subject name", "maxLength": 80 },
        "tema": { "type": "string", "description": "Theme / topic name", "maxLength": 150 },
        "title": { "type": "string", "description": "Task question or title" },
        "description": { "type": "string", "description": "Detailed explanation or task instructions" },
        "academicLevel": { "type": "string", "description": "Level" },
        "status": { "type": "string", "description": "Task status", "enum": ["pendente", "feita"] },
        "options": { "type": "array", "description": "Multiple choice options" },
        "correctAnswer": { "type": "string", "description": "Expected answer" },
        "studentAnswer": { "type": "string", "description": "Answer submitted by student" },
        "isCorrect": { "type": "boolean", "description": "Grading indicator" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "disciplina", "tema", "title", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Registered EduMind students profiles"
    },
    "/disciplinas/{disciplinaId}": {
      "schema": { "$ref": "#/entities/Disciplina" },
      "description": "Student subject disciplines and themes"
    },
    "/resumos/{resumoId}": {
      "schema": { "$ref": "#/entities/Resumo" },
      "description": "Study summaries generated from Prof. Pacavira lessons"
    },
    "/tarefas/{tarefaId}": {
      "schema": { "$ref": "#/entities/Tarefa" },
      "description": "Study tasks and exercises with pending and completed states"
    }
  }
}
